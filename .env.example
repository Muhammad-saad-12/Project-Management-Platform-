# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust variables to match your local or cloud setup:
#   cp .env.example .env
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/work_management?schema=public"

# Authentication Secret (JWT)
# Minimum 32-character high-entropy secret string for signing and verifying tokens
JWT_SECRET="your-secure-jwt-secret-key-min-32-characters-long"

# Application Environment
NODE_ENV="development"
